{
	"name": "@19h47/listbox",
	"version": "1.0.4",
	"description": "Collapsible single-select listbox widget",
	"keywords": [
		"listbox",
		"accessibility",
		"a11y",
		"ES6"
	],
	"homepage": "https://github.com/19h47/19h47-listbox#readme",
	"bugs": {
		"url": "https://github.com/19h47/19h47-listbox/issues"
	},
	"repository": {
		"type": "git",
		"url": "git://github.com/19h47/19h47-listbox.git"
	},
	"license": "ISC",
	"author": "Jérémy Levron <jeremylevron@19h47.fr> (https://19h47.fr)",
	"type": "module",
	"files": [
		"dist"
	],
	"main": "./dist/listbox.umd.cjs",
	"module": "./dist/listbox.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/listbox.js",
			"require": "./dist/listbox.umd.cjs"
		}
	},
	"scripts": {
		"dev": "vite",
		"build": "vite build && tsc && vite build --config vite.config.docs.js",
		"build:docs": "vite build --config vite.config.docs.js",
		"deploy": "pnpm login && pnpm run build && pnpm publish --access public --no-git-checks"
	},
	"devDependencies": {
		"@19h47/prettier-config": "^2.0.0",
		"prettier": "^3.9.5",
		"typescript": "^7.0.2",
		"vite": "^8.1.4"
	},
	"packageManager": "pnpm@10.12.1",
	"prettier": "@19h47/prettier-config"
}
